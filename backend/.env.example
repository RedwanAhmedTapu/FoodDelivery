NODE_ENV=development
PORT=5000

# MongoDB — must be a replica set (or MongoDB Atlas, which always is one)
# for multi-document transactions used in order creation, subscription
# activation, and point ledger writes. See backend/README.md.
MONGODB_URI=mongodb://127.0.0.1:27017/food_delivery

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

CLIENT_URL=http://localhost:3000

# Base URL of THIS API (including /api/v1) — used to build SSLCommerz
# success/fail/cancel/IPN callback URLs. Override the individual
# SSLCOMMERZ_*_URL vars below instead if your callback paths differ.
API_BASE_URL=http://localhost:5000/api/v1

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- SSLCommerz (sandbox credentials from https://developer.sslcommerz.com) ---
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false
# Optional overrides — leave unset to auto-build from API_BASE_URL:
# SSLCOMMERZ_SUCCESS_URL=
# SSLCOMMERZ_FAIL_URL=
# SSLCOMMERZ_CANCEL_URL=
# SSLCOMMERZ_IPN_URL=

# --- Dispatch algorithm tuning ---
DISPATCH_SEARCH_RADIUS_KM=5
DISPATCH_OFFER_WINDOW_SECONDS=20
DISPATCH_MAX_ACTIVE_ORDERS_PER_RIDER=2
FRAUD_SCORE_BLOCK_THRESHOLD=10

# --- Delivery OTP ---
# The OTP is ALWAYS shown in-app + pushed live via Socket.IO — that's free
# and needs nothing below. Email is an OPTIONAL extra channel using free
# SMTP (e.g. a Gmail App Password, not a paid SMS gateway). Leave
# EMAIL_HOST unset to skip email entirely; nothing else breaks.
OTP_LENGTH=4
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@rickshawbites.com

# --- Seed script (npm run seed) ---
# Creates demo SUPER_ADMIN / CUSTOMER / SHOP_OWNER / DELIVERY_BOY accounts.
# All use SEED_PASSWORD unless individually overridden below.
SEED_PASSWORD=ChangeMe123!
ADMIN_EMAIL=admin@rickshawbites.com
ADMIN_PHONE=01700000000
ADMIN_NAME=Platform Admin
ADMIN_PASSWORD=ChangeMe123!
